@model CustomerVoice.Web.Models.Complaints.ComplaintSearchViewModel

@{
    ViewData["Title"] = "فهرست شکایت‌ها";
}

<style>
    .complaints-page {
        direction: rtl;
        text-align: right;
        padding: 24px 0;
    }

    .page-heading {
        color: #172554;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .page-subtitle {
        color: #64748b;
        margin-bottom: 24px;
    }

    .modern-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, .05);
    }

    .section-title {
        color: #1e293b;
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .form-label {
        color: #475569;
        font-weight: 600;
        font-size: 14px;
    }

    .form-control, .form-select {
        border-radius: 9px;
        border-color: #cbd5e1;
        min-height: 42px;
    }

        .form-control:focus, .form-select:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, .12);
        }

    .btn-search {
        background: #2563eb;
        color: white;
        border-radius: 9px;
        padding: 9px 22px;
        font-weight: 600;
    }

        .btn-search:hover {
            background: #1d4ed8;
            color: white;
        }

    .btn-reset {
        border: 1px solid #cbd5e1;
        color: #475569;
        border-radius: 9px;
        padding: 9px 18px;
    }

    .table-modern {
        vertical-align: middle;
        margin-bottom: 0;
        min-width: 1100px;
    }

        .table-modern thead th {
            background: #f1f5f9;
            color: #334155;
            font-weight: 700;
            padding: 15px 12px;
            white-space: nowrap;
            border-bottom: 1px solid #e2e8f0;
        }

        .table-modern tbody td {
            padding: 14px 12px;
            color: #475569;
            border-color: #edf2f7;
        }

        .table-modern tbody tr:hover {
            background: #f8fafc;
        }

    .tracking-code {
        color: #2563eb;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-badge {
        display: inline-block;
        background: #dcfce7;
        color: #166534;
        border-radius: 20px;
        padding: 5px 12px;
        font-size: 12px;
        font-weight: 700;
    }

    .btn-download {
        background: #eff6ff;
        color: #1d4ed8;
        border-radius: 8px;
        padding: 6px 10px;
        text-decoration: none;
        white-space: nowrap;
    }

    .btn-delete {
        border-radius: 8px;
    }

    .empty-state {
        text-align: center;
        color: #64748b;
        padding: 40px 15px;
    }

    .pagination .page-link {
        color: #2563eb;
        border-radius: 8px;
        margin: 0 3px;
    }

    .pagination .active .page-link {
        background: #2563eb;
        border-color: #2563eb;
        color: white;
    }
</style>

<div class="container complaints-page">

    <div class="mb-4">
        <h2 class="page-heading">فهرست شکایت‌ها</h2>
        <p class="page-subtitle">مشاهده، جستجو و مدیریت شکایت‌های ثبت‌شده</p>
    </div>

    <div class="modern-card">
        <h5 class="section-title">جستجو و فیلتر شکایت‌ها</h5>

        <form asp-action="Index" method="get">
            <div class="row">

                <div class="col-md-4 mb-3">
                    <label asp-for="Search" class="form-label">جستجو</label>
                    <input asp-for="Search" class="form-control"
                           placeholder="کد رهگیری، نام یا شماره موبایل" />
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="ProjectId" class="form-label">پروژه</label>
                    <select asp-for="ProjectId"
                            asp-items="Model.Projects"
                            class="form-select">
                        <option value="">همه پروژه‌ها</option>
                    </select>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="ServiceTypeId" class="form-label">نوع خدمات</label>
                    <select asp-for="ServiceTypeId"
                            asp-items="Model.ServiceTypes"
                            class="form-select">
                        <option value="">همه خدمات</option>
                    </select>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Status" class="form-label">وضعیت</label>
                    <select asp-for="Status" class="form-select">
                        <option value="">همه وضعیت‌ها</option>
                        <option value="Submitted">ثبت‌شده</option>
                    </select>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="FromDate" class="form-label">از تاریخ</label>
                    <input asp-for="FromDate" type="date" class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="ToDate" class="form-label">تا تاریخ</label>
                    <input asp-for="ToDate" type="date" class="form-control" />
                </div>

                <div class="col-12 d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-search">جستجو</button>
                    <a asp-action="Index" class="btn btn-reset">پاک کردن فیلترها</a>
                </div>

            </div>
        </form>
    </div>

    <div class="modern-card">
        <h5 class="section-title">نتایج شکایت‌ها</h5>

        @if (Model.Result.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-modern">
                    <thead>
                        <tr>
                            <th>کد رهگیری</th>
                            <th>نام و نام خانوادگی</th>
                            <th>عنوان پروژه</th>
                            <th>نوع خدمات</th>
                            <th>شرح شکایت</th>
                            <th>راه‌حل پیشنهادی</th>
                            <th>مستندات</th>
                            <th>وضعیت</th>
                            <th>تاریخ ثبت</th>
                            <th>حذف</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var complaint in Model.Result.Items)
                        {
                            var persianCalendar = new System.Globalization.PersianCalendar();
                            <tr>
                                <td class="tracking-code">@complaint.TrackingCode</td>
                                <td>@complaint.FirstName @complaint.LastName</td>
                                <td>@complaint.ProjectTitle</td>
                                <td>@complaint.ServiceTypeTitle</td>
                                <td>@complaint.Description</td>
                                <td>@(complaint.SuggestedSolution ?? "—")</td>
                                <td>
                                    @if (complaint.HasAttachment)
                                    {
                                        <a asp-controller="Complaints"
                                           asp-action="DownloadAttachment"
                                           asp-route-complaintId="@complaint.Id"
                                           class="btn-download">
                                            دانلود فایل
                                        </a>
                                    }
                                    else
                                    {
                                        <span>بدون پیوست</span>
                                    }
                                </td>
                                <td><span class="status-badge">@complaint.Status</span></td>
                                <td class="text-nowrap">
                                <td class="text-nowrap">
                                        @($"{persianCalendar.GetYear(complaint.CreatedAt):0000}/{persianCalendar.GetMonth(complaint.CreatedAt):00}/{persianCalendar.GetDayOfMonth(complaint.CreatedAt):00} {complaint.CreatedAt:HH:mm}")
                                </td>
                                </td>
                                <td>
                                    <form asp-controller="Complaints"
                                          asp-action="Delete"
                                          method="post"
                                          onsubmit="return confirm('آیا از حذف این شکایت مطمئن هستید؟');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="complaintId"
                                               value="@complaint.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-danger btn-delete">
                                            حذف
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <h6>شکایتی یافت نشد</h6>
                <p class="mb-0">با تغییر فیلترها دوباره جستجو کنید.</p>
            </div>
        }
    </div>

    @if (Model.Result.TotalPages > 1)
    {
        <nav dir="rtl">
            <ul class="pagination justify-content-center">

                <li class="page-item @(Model.Result.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-Search="@Model.Search"
                       asp-route-ProjectId="@Model.ProjectId"
                       asp-route-ServiceTypeId="@Model.ServiceTypeId"
                       asp-route-Status="@Model.Status"
                       asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-PageNumber="@(Model.Result.PageNumber - 1)">
                        قبلی
                    </a>
                </li>

                <li class="page-item disabled">
                    <span class="page-link">
                        صفحه @Model.Result.PageNumber از @Model.Result.TotalPages
                    </span>
                </li>

                <li class="page-item @(Model.Result.PageNumber >= Model.Result.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-Search="@Model.Search"
                       asp-route-ProjectId="@Model.ProjectId"
                       asp-route-ServiceTypeId="@Model.ServiceTypeId"
                       asp-route-Status="@Model.Status"
                       asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-PageNumber="@(Model.Result.PageNumber + 1)">
                        بعدی
                    </a>
                </li>

            </ul>
        </nav>
    }

</div>
