@{
    ViewData["Title"] = "ثبت موفق شکایت";
}

<div class="container mt-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-body text-center p-5">

                    <h3 class="text-success mb-4">
                        شکایت شما با موفقیت ثبت شد
                    </h3>

                    <p>کد پیگیری شکایت شما:</p>

                    <h4 class="text-primary mb-4">
                        @ViewBag.TrackingCode
                    </h4>

                    <p>
                        لطفاً کد پیگیری را برای بررسی وضعیت شکایت نزد خود نگه دارید.
                    </p>
                    <div class="d-flex justify-content-center align-items-center flex-wrap gap-3 mt-4" dir="rtl">
                        <a asp-controller="Complaints"
                           asp-action="Create"
                           class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i>
                            ثبت شکایت جدید
                        </a>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-house-door"></i>
                            بازگشت به صفحه اصلی
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>