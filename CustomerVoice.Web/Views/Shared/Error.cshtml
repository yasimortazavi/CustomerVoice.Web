@model ErrorViewModel

@{
    ViewData["Title"] = "خطا";
}

<div class="container py-5 text-center" dir="rtl">
    <h1 class="text-danger mb-3">خطایی رخ داده است</h1>

    <p class="lead">
        متأسفانه هنگام پردازش درخواست شما مشکلی پیش آمد.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            کد پیگیری خطا:
            <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-primary mt-3">
        بازگشت به صفحه اصلی
    </a>
</div>